  "homepage": "https://routerbase.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zenlee123/routerbase-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zenlee123/routerbase-mcp/issues"
  },
  "license": "MIT",
  "mcpName": "io.github.zenlee123/routerbase-mcp",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.8.3"
  }
}
