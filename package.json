{
  "name": "routerbase-mcp",
  "version": "0.1.0",
  "description": "MCP server for RouterBase model discovery, pricing lookup, and OpenAI-compatible chat calls.",
  "type": "module",
  "bin": {
    "routerbase-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json",
    "metadata",
    "SUBMISSION_KIT.md"
  ],
  "scripts": {
