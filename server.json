{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zenlee123/routerbase-mcp",
  "description": "MCP server for RouterBase model discovery, pricing lookup, and OpenAI-compatible chat calls.",
  "repository": {
    "url": "https://github.com/zenlee123/routerbase-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "routerbase-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "RouterBase API key from https://routerbase.com",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "ROUTERBASE_API_KEY"
        }
      ]
    }
  ]
}
